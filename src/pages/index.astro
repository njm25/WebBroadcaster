---
import Base from '../layouts/Base.astro';
import '../styles/vendor/dockview.css';
import '../styles/studio.css';
---

<Base title="WebBroadcaster · Studio" bodyClass="studio-body">
  <div class="studio" id="studio">
    <header class="topbar">
      <div class="brand" title="WebBroadcaster">
        <!-- Same artwork as public/favicon.svg -->
        <svg class="app-icon" viewBox="0 0 32 32" aria-label="WebBroadcaster" role="img">
          <rect width="32" height="32" rx="7" fill="#16181d"></rect>
          <circle cx="16" cy="16" r="9" fill="none" stroke="#e5484d" stroke-width="3"></circle>
          <circle cx="16" cy="16" r="4" fill="#e5484d"></circle>
        </svg>
      </div>
      <nav class="menubar" id="menubar" role="menubar" aria-label="Main menu"></nav>
      <div class="top-right">
        <label class="switch" title="Studio mode: edit a preview scene, then Transition it to program">
          <input type="checkbox" id="studio-mode" /> <span>Studio mode</span>
        </label>
        <span class="rec-pill" id="rec-pill" hidden></span>
      </div>
    </header>

    <div class="audio-banner" id="audio-banner" hidden>
      Audio is paused by the browser. <button class="btn sm primary" id="audio-resume">Enable audio</button>
    </div>

    <!-- Dockable workspace (see src/studio/docking.ts) -->
    <div class="dock-root" id="dock-root"></div>

    <!-- Panel contents; the docking system moves each into its panel. -->
    <div class="panel-src" hidden>
      <div class="panel-fill" id="panel-program">
        <div class="views" id="views">
          <div class="view" id="view-preview">
            <div class="view-label">Preview</div>
            <div class="view-stage"><div class="canvas-wrap" id="wrap-preview"></div></div>
          </div>
          <div class="take-col" id="take-col">
            <button class="btn primary" id="take">Transition ▸</button>
          </div>
          <div class="view" id="view-program">
            <div class="view-label"><span class="live-dot"></span> Program</div>
            <div class="view-stage"><div class="canvas-wrap" id="wrap-program"></div></div>
          </div>
        </div>
      </div>
      <aside class="panel-fill props" id="props"></aside>
      <div class="panel-fill dock-body" id="dock-scenes"></div>
      <div class="panel-fill dock-body" id="dock-sources"></div>
      <div class="panel-fill dock-body" id="dock-mixer"></div>
      <div class="panel-fill dock-body" id="dock-devices"></div>
      <div class="panel-fill dock-body" id="dock-controls"></div>
    </div>
  </div>
  <div id="modal-root"></div>

  <script>
    import { startStudio } from '../studio/main';
    startStudio();
  </script>
</Base>
